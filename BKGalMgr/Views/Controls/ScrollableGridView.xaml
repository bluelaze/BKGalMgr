<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="BKGalMgr.Views.Controls.ScrollableGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:BKGalMgr.Views.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mcontrols="using:CommunityToolkit.WinUI.Controls"
             xmlns:mui="using:CommunityToolkit.WinUI"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ScrollButtonStyle"
               BasedOn="{StaticResource DefaultButtonStyle}"
               TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="root_Grid" SizeChanged="root_Grid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <ContentPresenter Content="{x:Bind Header, Mode=OneWay}" />
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button x:Name="left_scroll_Button"
                    Click="left_scroll_Button_Click"
                    Content="{mui:FontIcon FontSize=12,
                                           Glyph=&#xE76B;}"
                    Style="{StaticResource ScrollButtonStyle}" />
            <Button x:Name="right_scroll_Button"
                    Click="right_scroll_Button_Click"
                    Content="{mui:FontIcon FontSize=12,
                                           Glyph=&#xE76C;}"
                    Style="{StaticResource ScrollButtonStyle}" />
        </StackPanel>

        <local:ScrollableFlipView x:Name="scrollable_FlipView"
                                  Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top"
                                  Background="{x:Null}"
                                  HideFlipButton="True"
                                  IsFlipEnabled="False"
                                  ItemsSource="{x:Bind _itemSource, Mode=OneWay}"
                                  SelectionChanged="scrollable_FlipView_SelectionChanged">
            <local:ScrollableFlipView.ItemTemplate>
                <DataTemplate x:DataType="local:ScrollableGridViewItem">
                    <ItemsControl ItemTemplate="{x:Bind ItemTemplate, Mode=OneWay}"
                                  ItemsSource="{x:Bind Items, Mode=OneWay}"
                                  Tapped="ItemsControl_Tapped">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <mcontrols:UniformGrid ColumnSpacing="{Binding ColumnSpacing, Mode=OneWay}"
                                                       Columns="{Binding Columns, Mode=OneWay}"
                                                       RowSpacing="{Binding RowSpacing, Mode=OneWay}"
                                                       Rows="{Binding Rows, Mode=OneWay}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DataTemplate>
            </local:ScrollableFlipView.ItemTemplate>
        </local:ScrollableFlipView>
    </Grid>
</UserControl>
